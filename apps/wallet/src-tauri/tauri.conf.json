{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zevrigo Wallet",
  "version": "0.2.0",
  "identifier": "com.zevrigo.wallet",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Zevrigo Wallet",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Zevrigo",
    "license": "MIT OR Apache-2.0",
    "licenseFile": "PRIVASI-DAN-LISENSI.txt",
    "homepage": "https://github.com/ratuaurion-dev/zevrigo",
    "copyright": "Pembuat Zevrigo, MIT OR Apache-2.0",
    "shortDescription": "Wallet desktop Zevrigo Coin (ZVRG)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
